  "connectivity_issues_by_block_type": {
    "equipment_with_nozzles": {
      "issue": "Nozzles defined as coordinate lists in YAML, not as semantic port objects",
      "impact": "Pipe routing must manually match nozzle coordinates; no type checking",
      "example": "T-501.N1_feed_inlet has wall_point, stub_end, pipe_connection but no type/domain"
    },
    "equipment_with_ports": {
      "issue": "Ports are named offsets without semantic type",
      "impact": "Cannot validate that suction connects to discharge vs instrument signal",
      "example": "Pump.suction [-24, 0] could connect to anything"
    },
    "instruments": {
      "issue": "Generic field_instrument block used for PT, TT, LT, FT, etc.",
      "impact": "No validation that pressure transmitter connects to pressure tap vs level tap",
      "example": "PT-501 and LT-501 use same block with same generic ports"
    },
    "valves": {
      "issue": "Control valve and shutdown valve have different port counts but same base type",
      "impact": "Solenoid signals vs actuator signals not distinguished",
      "example": "XV has solenoid_signal, ZSO, ZSC; CV has actuator_signal, instrument_air"
    },
    "signal_lines": {
      "issue": "Signal type is metadata on line, not enforced by connection types",
      "impact": "Electric signal could connect to pneumatic port without error",
      "example": "signal_type: electric_analog in YAML but no type checking at connection"
    },
    "process_lines": {
      "issue": "Lines reference coordinates, not source/target objects",
      "impact": "Cannot trace network topology or validate continuity",
      "example": "from_ref resolves to (x,y) coordinate tuple, losing object identity"
    }
  },
